apk-output/
*.apk
android-app/.gradle/
android-app/build/
android-app/app/build/

# 本地构建环境 (JDK/SDK/Gradle), 不入库
.local/

# gradle-wrapper.jar 由 CI 下载 (见 build-android.yml), 不入库
android-app/gradle/wrapper/gradle-wrapper.jar

# 本地 Android SDK 路径 (CI 用环境变量, 本地用 local.properties), 不入库
android-app/local.properties

# opencode 运行环境 (二进制+musl库) 由 gradle downloadOpencode 自动下载, 不入库
android-app/app/src/main/jniLibs/
android-app/app/src/main/assets/opencode/

# opencode 本地会话产物, 不入库
**/.omo/

# 临时 openssl 中间产物 (最终 keystore 已提交)
android-app/debug-key.pem
android-app/debug-cert.pem
